{
  "name": "vasu-juari-poker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,socket -c cyan,green \"next dev --webpack -p 3000\" \"tsx --tsconfig tsconfig.server.json server.ts\"",
    "dev:next": "next dev --webpack -p 3000",
    "dev:socket": "tsx --tsconfig tsconfig.server.json server.ts",
    "build": "next build --webpack",
    "start": "NODE_ENV=production tsx --tsconfig tsconfig.server.json server.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "next": "16.2.12",
    "pokersolver": "^2.1.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
